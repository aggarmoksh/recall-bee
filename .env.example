BEE_PROXY_PORT=8787
LLM_PROVIDER=bedrock
# Primary (AGENT.md, revised 2026-09-28): Claude Haiku 4.5 via its US Geo
# cross-region inference profile ID (bare model ID isn't valid for on-demand
# throughput -- see https://docs.aws.amazon.com/bedrock/latest/userguide/model-card-anthropic-claude-haiku-4-5.html).
LLM_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
# Fallback if AWS credits don't cover Anthropic usage, or if Haiku access is
# blocked (Bedrock model access request/form): switch LLM_MODEL to Nova 2
# Lite's US Geo cross-region inference profile ID instead --
# LLM_MODEL=us.amazon.nova-2-lite-v1:0
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# Dev-only fallback provider (LLM_PROVIDER=gemini) -- see phase4/nova_vs_gemini.md
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
TIMEZONE=America/Los_Angeles
# Kept only for recall.dispatch's to_local() helper; no longer read by
# session/stings (AGENT.md v4, Phase 5C).
RECALL_PROFILE=normal
# v4 pull-with-nudges model (AGENT.md, Phase 5C): the window Recall is
# allowed to sting/dispatch in. May wrap past midnight, e.g. 13:00-03:00.
ACTIVE_WINDOW=18:00-00:00
# Questions answered per day before the goal is met and stings stop.
DAILY_QUOTA=6
# Local time a new "recall day" begins -- streak/goal boundary, not midnight.
DAY_RESET=04:00
# Max time-based stings/day (start/middle/end-90min); the post-lecture
# sting is additional and doesn't count against this cap.
MAX_STINGS=3
