    {
     "text": "Claude Haiku on Amazon Bedrock writes the questions, each tied to the moment I heard it.",
     "from": 9.64,
     "to": 16.9
    },
    {
     "text": "When I'm free, I say so, or tick a todo. Each question goes out as a Bee todo with an alarm.",
     "from": 16.9,
     "to": 24.5
    },
